# ──────────────────────────────────────────────
# Modèle de configuration — copier en .env : cp .env.example .env
# Ne JAMAIS commiter le fichier .env
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
# Générer une vraie valeur : openssl rand -hex 32
SECRET_KEY=change-me

# PostgreSQL (utilisé par l'application ET par docker compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskflow

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
